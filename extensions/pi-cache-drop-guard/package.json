{
  "name": "pi-cache-drop-guard",
  "version": "0.1.0",
  "description": "Detect consecutive prompt-cache drops in Pi and ask whether to continue, inspect status, keep alerting, or mute",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "keywords": ["pi-package", "pi", "cache", "prompt-cache", "cost", "guard"],
  "files": ["index.ts", "README.md", "LICENSE"],
  "pi": { "extensions": ["./index.ts"] },
  "scripts": { "test": "node --experimental-strip-types --test tests/*.test.mjs", "typecheck": "tsc --noEmit" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.0 <2.0.0",
    "@earendil-works/pi-tui": ">=1.0.0 <2.0.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@earendil-works/pi-tui": "^1.0.0",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
