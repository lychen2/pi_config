{
  "name": "pi-science-workbench",
  "version": "0.1.0",
  "description": "Opt-in scientific execution, job provenance and validation for Pi",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22.19.0" },
  "keywords": ["pi-package", "science", "optics"],
  "pi": { "extensions": ["./index.ts"], "skills": ["./skills"] },
  "files": ["index.ts", "src", "python", "schemas", "skills", "README.md", "LICENSE"],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.mjs && python3 -B -m unittest discover -s tests/python -v",
    "typecheck": "tsc --noEmit",
    "test:ssh": "python3 -B tests/ssh_integration.py"
  },
  "dependencies": { "typebox": "^1.3.14" },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0 <0.86.0",
    "@earendil-works/pi-ai": ">=0.85.0 <0.86.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
