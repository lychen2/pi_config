{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "title":"Scientific run snapshot",
 "type":"object",
 "required":["schema_version","run_id","request_id","execution_status","artifact_status","validation_status","completion_status","artifacts"],
 "properties":{
  "schema_version":{"const":1},
  "run_id":{"type":"string","pattern":"^[a-zA-Z0-9_-]{1,128}$"},
  "request_id":{"type":"string","pattern":"^[a-zA-Z0-9_-]{1,128}$"},
  "execution_status":{"enum":["pending","running","succeeded","failed","timed_out","cancelled","unknown"]},
  "artifact_status":{"enum":["not_checked","complete","incomplete","invalid","unknown"]},
  "validation_status":{"enum":["not_checked","passed","failed","unknown"]},
  "completion_status":{"enum":["pending","verified","rejected","unverified"]},
  "artifacts":{"type":"array","items":{"$ref":"artifact.schema.json"}}
 }
}
