{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Science Workbench project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "defaultProfile", "profiles"],
  "properties": {
    "schemaVersion": {"const": 1},
    "defaultProfile": {"type": "string"},
    "profiles": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"pattern": "^[a-zA-Z0-9_-]{1,64}$"},
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["transport", "python", "executionTrust", "environmentAllowlist"],
        "properties": {
          "transport": {"enum": ["local", "ssh"]},
          "python": {"type": "string", "pattern": "^/"},
          "executionTrust": {"const": "trusted-host"},
          "environmentAllowlist": {"type": "array", "items": {"type": "string", "pattern": "^[A-Z_][A-Z0-9_]*$"}},
          "sshAlias": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,127}$"},
          "remoteRunRoot": {"type": "string", "pattern": "^/.+"}
        },
        "allOf": [{"if": {"properties": {"transport": {"const": "ssh"}}}, "then": {"required": ["sshAlias", "remoteRunRoot"]}}]
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "kernelCellTimeoutSeconds": {"type": "integer", "minimum": 1},
        "jobTimeoutSeconds": {"type": "integer", "minimum": 1},
        "maxLocalJobs": {"type": "integer", "minimum": 1},
        "maxRemoteJobsPerHost": {"type": "integer", "minimum": 1},
        "maxSubmissionsPerGrant": {"type": "integer", "minimum": 1},
        "maxToolResultBytes": {"type": "integer", "minimum": 1024, "maximum": 65536},
        "maxLogBytesPerRun": {"type": "integer", "minimum": 1},
        "maxTransferBytesPerRun": {"type": "integer", "minimum": 1}
      }
    }
  }
}
