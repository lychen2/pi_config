{
  "name": "pi-context-bridge",
  "version": "0.2.0",
  "description": "Default-profile bridge for Web Access and manager models",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "web"
  ],
  "files": [
    "index.ts",
    "manager-models.ts",
    "continuity.ts",
    "rtk.ts",
    "rtk-compat.ts",
    "wire-guard.ts",
    "teammate.ts",
    "teammate-contract.ts",
    "patch-teammate.mjs",
    "teammate-config.json",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts",
      "./rtk.ts",
      "./teammate.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.mjs",
    "postinstall": "node patch-teammate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "pi-maestro-teammate": "2.6.2",
    "pi-rtk-optimizer": "0.9.0",
    "pi-web-access": "*",
    "typebox": "^1.3.34"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.85.0 <0.86.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
