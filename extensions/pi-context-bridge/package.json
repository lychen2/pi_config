{
  "name": "pi-context-bridge",
  "version": "0.2.0",
  "description": "Default-profile bridge for Web Access and manager models",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "web"
  ],
  "files": [
    "index.ts",
    "manager-models.ts",
    "continuity.ts",
    "rtk.ts",
    "rtk-compat.ts",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./index.ts",
      "./rtk.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "pi-web-access": "*",
    "pi-rtk-optimizer": "0.9.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.82.0 <0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
