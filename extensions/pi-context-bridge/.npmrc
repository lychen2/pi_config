# pi-rtk-optimizer 0.9.0 still declares peer ranges for Pi <= 0.80, while this
# repository targets Pi 0.82-0.85. npm's strict peer resolution aborts with
# ERESOLVE on the versions we pin, so resolve without peer validation here.
# The RTK surface is verified by tests/rtk-compat.test.mjs against the pinned Pi
# versions in scripts/verify-repository.mjs.
legacy-peer-deps=true
