{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "bash-guard.ts",
    "index.ts",
    "session-tools/**/*.ts",
    "code-outline/**/*.ts",
    "deferred-tools/**/*.ts",
    "browser/**/*.ts",
    "todo/**/*.ts",
    "maestro/**/*.ts",
    "preview/**/*.ts",
    "large-mode.ts",
    "large-mode-core.ts"
  ]
}
