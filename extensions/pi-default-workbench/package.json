{
  "name": "pi-default-workbench",
  "version": "0.1.0",
  "description": "Default-profile workbench for tool selection, browser control, Todo, workspace tools, and Markdown preview",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "workbench",
    "tools",
    "todo",
    "browser",
    "preview"
  ],
  "files": [
    "index.ts",
    "lazy-tools.ts",
    "bash-guard.ts",
    "deferred-tools",
    "browser",
    "todo",
    "maestro",
    "preview",
    "large-mode.ts",
    "large-mode-core.ts",
    "skill-search.ts",
    "embedding-search.ts",
    "scripts/fetch-embedding-model.mjs",
    "README.md",
    "config.example.json",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ff-labs/fff-node": "^0.10.6",
    "@huggingface/transformers": "^4.2.0",
    "jiti": "^2.7.0",
    "pi-markdown-preview": "*",
    "puppeteer-core": "^25.10.0",
    "typebox": "^1.3.14"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.85.0 <0.86.0",
    "@earendil-works/pi-ai": ">=0.85.0 <0.86.0",
    "@earendil-works/pi-coding-agent": ">=0.85.0 <0.86.0",
    "@earendil-works/pi-tui": ">=0.85.0 <0.86.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-coding-agent": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@types/node": "^26.5.1",
    "typescript": "^7.0.2"
  }
}
