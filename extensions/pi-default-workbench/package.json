{
  "name": "pi-default-workbench",
  "version": "0.1.0",
  "description": "Default-profile workbench for tool selection, browser control, Todo, workspace tools, and Markdown preview",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "pi-package",
    "pi",
    "workbench",
    "tools",
    "todo",
    "browser",
    "preview"
  ],
  "files": [
    "index.ts",
    "lazy-tools.ts",
    "deferred-tools",
    "browser",
    "todo",
    "maestro",
    "preview",
    "large-mode.ts",
    "large-mode-core.ts",
    "skill-search.ts",
    "README.md",
    "config.example.json",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test tests/**/*.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ff-labs/fff-node": "0.10.3",
    "@huggingface/transformers": "^3.8.1",
    "jiti": "2.7.0",
    "pi-markdown-preview": "0.14.0",
    "puppeteer-core": "24.31.0",
    "typebox": "1.3.14"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.82.0 <0.85.0",
    "@earendil-works/pi-ai": ">=0.82.0 <0.85.0",
    "@earendil-works/pi-coding-agent": ">=0.82.0 <0.85.0",
    "@earendil-works/pi-tui": ">=0.82.0 <0.85.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.0",
    "@earendil-works/pi-ai": "^0.84.0",
    "@earendil-works/pi-coding-agent": "^0.84.0",
    "@earendil-works/pi-tui": "^0.84.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
