# Credentials and private runtime data
**/*auth*
**/*secret*
**/*token*
**/*password*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/models.json
**/auth.json
**/sessions/
**/cache/
**/backups/
**/node_modules/
**/.env
**/.env.*

# Local/runtime state
**/*.sqlite
**/*.sqlite-*
**/*.db
**/*.db-*
**/*.log
**/*.tmp
**/*.catalog_stamp

# Generated or machine-specific material
**/assets/
**/dist/
**/build/
.DS_Store

# Workflow knowledge-base runtime state (embeddings, caches); specs/ stays tracked
.workflow/*
!.workflow/specs/

# Machine-local overrides
.pi/settings.local.json

# Plan-mode session drafts
/docs/plans/

# Legacy large-mode launcher (superseded by /large on)
/bin/pi-large

# Stray root lockfile (no root package.json)
/package-lock.json
