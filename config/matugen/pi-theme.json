{
  "$schema": "https://raw.githubusercontent.com/earendil-works/pi/main/packages/coding-agent/src/modes/interactive/theme/theme-schema.json",
  "name": "matugen",
  "appearance": "dark",
  "vars": {
    "primary": "{{colors.primary.default.hex}}",
    "primaryBright": "{{colors.primary_fixed.default.hex}}",
    "secondary": "{{colors.secondary.default.hex}}",
    "secondaryContainer": "{{colors.secondary_container.default.hex}}",
    "tertiary": "{{colors.tertiary.default.hex}}",
    "errorColor": "{{colors.error.default.hex}}",
    "diffAdded": "{{colors.diff_added.default.hex}}",
    "wallpaperDiffRemoved": "{{colors.diff_removed.default.hex}}",
    "warningColor": "{{colors.warning.default.hex}}",
    "foreground": "{{colors.on_surface.default.hex}}",
    "foregroundMuted": "{{colors.on_surface_variant.default.hex}}",
    "outline": "{{colors.outline.default.hex}}",
    "outlineMuted": "{{colors.outline_variant.default.hex}}",
    "surface": "{{colors.surface.default.hex}}",
    "surfaceLowest": "{{colors.surface_container_lowest.default.hex}}",
    "surfaceLow": "{{colors.surface_container_low.default.hex}}",
    "surfaceContainer": "{{colors.surface_container.default.hex}}",
    "surfaceHigh": "{{colors.surface_container_high.default.hex}}",
    "surfaceHighest": "{{colors.surface_container_highest.default.hex}}",
    "surfaceBright": "{{colors.surface_bright.default.hex}}",
    "surfaceVariant": "{{colors.surface_variant.default.hex}}",
    "tertiaryContainer": "{{colors.tertiary_container.default.hex}}",
    "errorContainer": "{{colors.error_container.default.hex}}",
    "error": "#FF6B81",
    "errorSurface": "#301C24",
    "errorInk": "#241217",
    "success": "#A6DFB5",
    "warning": "#F2C879",
    "diffRemoved": "#DE9EAC"
  },
  "colors": {
    "accent": "primary",
    "border": "outlineMuted",
    "borderAccent": "primaryBright",
    "borderMuted": "outlineMuted",
    "success": "success",
    "error": "error",
    "warning": "warning",
    "muted": "foregroundMuted",
    "dim": "outline",
    "text": "foreground",
    "thinkingText": "foregroundMuted",
    "selectedBg": "surfaceHigh",
    "userMessageBg": "surfaceLow",
    "userMessageText": "foreground",
    "customMessageBg": "surfaceContainer",
    "customMessageText": "foreground",
    "customMessageLabel": "secondary",
    "toolPendingBg": "surfaceContainer",
    "toolSuccessBg": "surfaceLow",
    "toolErrorBg": "errorSurface",
    "toolTitle": "primaryBright",
    "toolOutput": "foreground",
    "mdHeading": "primaryBright",
    "mdLink": "primaryBright",
    "mdLinkUrl": "secondary",
    "mdCode": "tertiary",
    "mdCodeBlock": "foreground",
    "mdCodeBlockBorder": "outline",
    "mdQuote": "foregroundMuted",
    "mdQuoteBorder": "secondary",
    "mdHr": "outlineMuted",
    "mdListBullet": "tertiary",
    "toolDiffAdded": "diffAdded",
    "toolDiffRemoved": "diffRemoved",
    "toolDiffContext": "foregroundMuted",
    "syntaxComment": "outline",
    "syntaxKeyword": "primary",
    "syntaxFunction": "secondary",
    "syntaxVariable": "foregroundMuted",
    "syntaxString": "tertiary",
    "syntaxNumber": "primaryBright",
    "syntaxType": "tertiary",
    "syntaxOperator": "primary",
    "syntaxPunctuation": "outline",
    "thinkingOff": "outlineMuted",
    "thinkingMinimal": "foregroundMuted",
    "thinkingLow": "secondary",
    "thinkingMedium": "primary",
    "thinkingHigh": "tertiary",
    "thinkingXhigh": "primaryBright",
    "thinkingMax": "primaryBright",
    "bashMode": "primaryBright"
  },
  "export": {
    "pageBg": "{{colors.surface.default.hex}}",
    "cardBg": "{{colors.surface_container.default.hex}}",
    "infoBg": "{{colors.surface_container_high.default.hex}}"
  }
}
